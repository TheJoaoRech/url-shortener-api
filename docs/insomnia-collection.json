      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "parentId": "folder_auth"
    },
    {
      "_id": "req_login",
      "_type": "request",
      "name": "Login",
      "method": "POST",
      "url": "{{ _.baseUrl }}/auth/login",
      "description": "Authenticate with email and password. Returns JWT token.",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
      },
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
