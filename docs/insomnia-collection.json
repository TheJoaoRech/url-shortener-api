    },
    {
      "_id": "folder_urls",
      "_type": "request_group",
      "name": "URLs",
      "description": "URL shortening and management endpoints",
      "environment": {},
      "parentId": "wrk_url_shortener"
    },
    {
      "_id": "req_shorten_auth",
      "_type": "request",
      "name": "Shorten URL (Authenticated)",
      "method": "POST",
      "url": "{{ _.baseUrl }}/shorten",
      "description": "Shorten a URL with authentication. The URL will be associated with your user account.",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"originalUrl\": \"https://github.com/TheJoaoRech/url-shortener-api\"\n}"
      },
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "Authorization",
          "value": "Bearer {{ _.token }}"
        }
      ],
      "parentId": "folder_urls"
    },
    {
      "_id": "req_shorten_custom",
      "_type": "request",
      "name": "Shorten URL with Custom Alias",
      "method": "POST",
      "url": "{{ _.baseUrl }}/shorten",
      "description": "Shorten a URL with a custom alias (3-30 characters, lowercase, numbers, dash, underscore).",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"originalUrl\": \"https://teddy360.com.br/material/marco-legal-das-garantias-sancionado-entenda-o-que-muda/\",\n  \"customAlias\": \"teddy-legal\"\n}"
      },
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "Authorization",
          "value": "Bearer {{ _.token }}"
        }
      ],
      "parentId": "folder_urls"
    },
    {
      "_id": "req_shorten_anon",
      "_type": "request",
      "name": "Shorten URL (Anonymous)",
      "method": "POST",
      "url": "{{ _.baseUrl }}/shorten",
      "description": "Shorten a URL without authentication. Anonymous URLs cannot be edited or deleted later.",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"originalUrl\": \"https://nestjs.com\"\n}"
      },
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "parentId": "folder_urls"
    },
    {
      "_id": "req_get_my_urls",
      "_type": "request",
      "name": "Get My URLs",
      "method": "GET",
      "url": "{{ _.baseUrl }}/my-urls",
      "description": "List all URLs created by the authenticated user. Soft-deleted URLs are excluded.",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {{ _.token }}"
        }
      ],
      "parentId": "folder_urls"
    },
    {
      "_id": "req_update_url",
      "_type": "request",
      "name": "Update URL",
      "method": "PUT",
      "url": "{{ _.baseUrl }}/my-urls/{{ _.urlId }}",
      "description": "Update the destination URL. The short code remains the same. Only the owner can update.",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"originalUrl\": \"https://github.com/TheJoaoRech/url-shortener-api/tree/main\"\n}"
      },
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "Authorization",
          "value": "Bearer {{ _.token }}"
        }
      ],
      "parentId": "folder_urls"
    },
    {
      "_id": "req_delete_url",
      "_type": "request",
      "name": "Delete URL (Soft Delete)",
      "method": "DELETE",
      "url": "{{ _.baseUrl }}/my-urls/{{ _.urlId }}",
      "description": "Soft delete a URL. The URL will no longer redirect and returns 404. The short code can be reused.",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {{ _.token }}"
        }
      ],
      "parentId": "folder_urls"
    },
    {
      "_id": "req_redirect",
      "_type": "request",
      "name": "Redirect to Original URL",
      "method": "GET",
      "url": "{{ _.baseUrl }}/{{ _.shortCode }}",
      "description": "Public endpoint that redirects to the original URL using the short code. Increments click counter automatically.",
      "headers": [],
      "parentId": "folder_urls"
    },
